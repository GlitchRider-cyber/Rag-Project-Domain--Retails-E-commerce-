# ── Gemini ──────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-4-hydrogen

# ── Database (PostgreSQL + pgvector) ────────────────────────
# Supabase example:  postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# Neon example:      postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurelia

# ── Admin ───────────────────────────────────────────────────
ADMIN_PASSWORD=change-this-in-production

# ── CORS ────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# ── Retrieval ────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RELEVANCE_THRESHOLD=0.3

